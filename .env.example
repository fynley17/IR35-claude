# Copy to .env for local development. On Vercel, set these under Project → Settings → Environment Variables.

# ─── Required ────────────────────────────────────────────────
BASE_URL=https://ir35-checker.com          # no trailing slash
ANTHROPIC_API_KEY=sk-ant-...
STRIPE_SECRET_KEY=sk_live_...              # sk_test_... for testing
STRIPE_WEBHOOK_SECRET=whsec_...
DATABASE_URL=postgres://...                # added automatically when you connect Neon in Vercel → Storage
CRON_SECRET=                               # any long random string; Vercel Cron sends it to /api/cron/sweep

# ─── Business details (shown in the footer, privacy notice and terms) ──
BUSINESS_TRADING_NAME=IR35 Checker
BUSINESS_LEGAL_NAME=                       # e.g. Fynley Solutions Ltd, or your own name if a sole trader
BUSINESS_COMPANY_NUMBER=                   # if a limited company
BUSINESS_ADDRESS=                          # registered office / trading address
CONTACT_EMAIL=                             # support address customers can reply to
ICO_REGISTRATION_NUMBER=                   # after paying the ICO data protection fee
VAT_NUMBER=                                # only if VAT registered
FOUNDER_NAME=                              # optional, shown on /about
CONTENT_REVIEWER_NAME=                     # optional, e.g. an accountant who reviews the guides
CONTENT_REVIEWER_CREDENTIALS=              # optional, e.g. "Chartered Tax Adviser"

# ─── Optional ────────────────────────────────────────────────
REPORT_PRICE_PENCE=900                     # £9.00
ANTHROPIC_MODEL=claude-sonnet-4-6          # model used for reports
RESEND_API_KEY=                            # emails the report link to customers (resend.com)
EMAIL_FROM=IR35 Checker <reports@ir35-checker.com>
PLAUSIBLE_DOMAIN=                          # cookieless analytics, e.g. ir35-checker.com
STRIPE_INVOICES=false                      # true = Stripe creates an invoice PDF per purchase (small Stripe fee)
REPORT_RETENTION_DAYS=30
UNPAID_RETENTION_HOURS=24

# ─── Local development only (ignored in production) ──────────
# FAKE_PAYMENTS=1                          # skip Stripe with a fake checkout page
# FAKE_AI=1                                # return the sample report instead of calling Claude
